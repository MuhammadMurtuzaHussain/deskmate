# ─── Brain (pick one; the local one needs no account) ───────────────────────────
# The setup window (menu-bar icon → Setup…) does this for you; values here win over what it saved.
# Claude through the Anthropic API (the agent on your Mac needs it): https://console.anthropic.com/settings/keys
# DESKMATE_BRAIN=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5          # or claude-sonnet-5-5, claude-haiku-5-5
# DESKMATE_AGENT_STEPS=25                  # tool rounds the agent may take per goal
# Local, free, private: install Ollama (https://ollama.com) and pull a vision model:
#   ollama pull qwen3-vl:4b-instruct          # 3.3 GB, good on 16 GB laptops
# then set:
DESKMATE_BRAIN=ollama
OLLAMA_MODEL=qwen3-vl:4b-instruct
# OLLAMA_URL=http://127.0.0.1:11434

# Cloud alternative: Google AI Studio (free tier has a daily quota). Key: https://aistudio.google.com/apikey
# You can also paste the key inside the app. Leave DESKMATE_BRAIN empty to prefer Gemini when a key exists.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# ─── Voice (optional; without any of these she uses the system voice) ───────────
# Local, free: run tts-local/setup.sh once (Kokoro + Whisper), then:
# DESKMATE_TTS=local
# DESKMATE_TTS_VOICE=af_heart
# Cloud: ElevenLabs (built-in voices work on the free tier)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_MODEL=eleven_flash_v2_5

# ─── Ears (talk to her; needs the local voice server above) ─────────────────────
# local = on (default when DESKMATE_TTS=local), off = never load Whisper
# DESKMATE_STT=local
# Whisper size: tiny.en / base.en (light) · small.en (default, good) · small / medium (other languages)
# DESKMATE_STT_MODEL=small.en
# Toggle hands-free listening (tray menu and the mic button do the same)
# DESKMATE_LISTEN_SHORTCUT=CommandOrControl+Shift+Space
# word = her ears are on from launch and she answers only after her name: "Mika, …", or "Mika?" and then your question
#        (spelling is forgiving: Mica, Meeka). off (default) = she answers everything while listening is on.
# DESKMATE_WAKE_MODE=off
# 1 = the older switch: the same name gate, but listening still starts with the shortcut
# DESKMATE_WAKE_NAME=0
# 0 = close the mic while she talks instead of letting you interrupt her mid-sentence (barge-in)
# DESKMATE_BARGE_IN=1

# ─── Browser (she drives your own Chrome; macOS, see docs/AGENT.md) ──────────────
# One-time in Chrome: View → Developer → Allow JavaScript from Apple Events (reading pages, clicking, typing need it)
# DESKMATE_BROWSER_APP=Google Chrome      # or Brave Browser, Microsoft Edge, …
# DESKMATE_SEARCH_URL=https://www.google.com/search?q=%s
# DESKMATE_BROWSE_STEPS=12                # how many look-decide-act steps a browsing goal may take

# ─── Apps (she messages on Discord and Slack, prompts the Claude app; macOS, see docs/AGENT.md) ──
# Needs Accessibility for Deskmate (Electron or your terminal when run from source); she asks the first time.
# When a message is read back and waits for your "yes": always (default) | voice (spoken requests only) | never
# DESKMATE_CONFIRM_SENDS=always
# Prompts typed into the Claude app follow DESKMATE_CONFIRM_JOBS below.

# ─── Hands (she gives jobs to Claude Code; see docs/AGENT.md) ────────────────────
# Claude Code must be installed and logged in: https://docs.anthropic.com/en/docs/claude-code
# Folder jobs run in when you don't name one (the tray menu can pick it too)
# DESKMATE_WORKDIR=~/Desktop/my-project
# Named folders, so "resume the vlog" finds the right place. Folders you already used Claude Code in are found automatically.
# DESKMATE_PROJECTS=vlog=~/Movies/vlog;site=~/Desktop/personal-website
# When she reads a job back and waits for a "yes": voice (default: spoken requests only) | always | never
# DESKMATE_CONFIRM_JOBS=voice
# What Claude may do without asking: acceptEdits (default: edit files in the folder) | default | plan | bypassPermissions
# DESKMATE_CLAUDE_PERMISSION_MODE=acceptEdits
# DESKMATE_CLAUDE_MODEL=            # e.g. sonnet, for cheaper jobs
# DESKMATE_CLAUDE_MAX_TURNS=        # cap how long a job may run
# DESKMATE_CLAUDE_BIN=              # if `claude` is not on PATH

# ─── Window and shortcuts ───────────────────────────────────────────────────────
# The command bar: type what you want from anywhere
# DESKMATE_COMMAND_SHORTCUT=Alt+Space
# auto (default): her panel tucks away until you hover over her · always: it stays
# DESKMATE_PANEL=auto

# ─── Awareness ──────────────────────────────────────────────────────────────────
# A project folder to watch for file changes (optional)
DESKMATE_WATCH_DIR=
# Seconds between screen looks while watch mode is on
DESKMATE_WATCH_INTERVAL=60

# ─── Character ──────────────────────────────────────────────────────────────────
# Folder name under character/ (or <user data>/character/). The tray menu switches this too.
DESKMATE_CHARACTER=mika
