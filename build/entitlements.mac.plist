<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Deskmate.app under the hardened runtime (Developer ID builds only; see docs/RELEASING.md). Not sandboxed. -->
<plist version="1.0">
  <dict>
    <!-- V8 and WebAssembly (the MMD physics) need JIT pages. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- electron-builder's default: Electron's frameworks and helpers load each other. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Hands-free listening (askForMediaAccess in the main process, capture in the renderer). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- No camera: she looks at the screen, never at you. -->
    <key>com.apple.security.device.camera</key>
    <false/>
    <!-- AppleScript to Chrome, Spotify, Messages, Notes (osascript runs on her behalf). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Calendar nudges read events through EventKit (in deskmate-hands; asked from here too). -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
  </dict>
</plist>
