{
  "name": "deskmate",
  "version": "0.6.0",
  "private": true,
  "description": "A Live2D or 3D (VRM / MMD) AI desk companion that lives on your screen and talks back: speech to speech with a local Whisper + Kokoro voice, sees what you do, drives your Chrome, hands real work to Claude Code, dances when you ask, remembers you. Runs fully local with Ollama, or on Gemini.",
  "main": "./out/main/index.js",
  "scripts": {
    "ensure-electron": "node scripts/ensure-electron.cjs",
    "dev": "node scripts/ensure-electron.cjs && node scripts/build-hands.cjs && electron-vite dev",
    "build": "node scripts/ensure-electron.cjs && node scripts/build-hands.cjs && electron-vite build",
    "start": "node scripts/ensure-electron.cjs && node scripts/build-hands.cjs && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "build:hands": "node scripts/build-hands.cjs",
    "dist": "node scripts/ensure-electron.cjs && node scripts/build-hands.cjs --universal && electron-vite build && electron-builder",
    "dist:mac": "node scripts/ensure-electron.cjs && node scripts/build-hands.cjs --universal && electron-vite build && electron-builder --mac",
    "dist:win": "node scripts/ensure-electron.cjs && electron-vite build && electron-builder --win",
    "dist:linux": "node scripts/ensure-electron.cjs && electron-vite build && electron-builder --linux",
    "pack": "node scripts/ensure-electron.cjs && node scripts/build-hands.cjs --universal && electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pixi/unsafe-eval": "^7.4.3",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "chokidar": "^5.0.0",
    "pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
    "pixi.js": "^7.4.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0"
  },
  "productName": "Deskmate",
  "author": {
    "name": "Muhammad Murtuza Hussain",
    "email": "muhammadmurtuzahussain@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/MuhammadMurtuzaHussain/deskmate#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuhammadMurtuzaHussain/deskmate.git"
  },
  "bugs": {
    "url": "https://github.com/MuhammadMurtuzaHussain/deskmate/issues"
  },
  "keywords": [
    "3d-avatar",
    "agent",
    "agentic-browsing",
    "ai-companion",
    "anime",
    "browser-automation",
    "chrome",
    "claude-code",
    "desktop-companion",
    "desktop-pet",
    "electron",
    "gemini",
    "hands-free",
    "kokoro",
    "linux",
    "live2d",
    "local-llm",
    "macos",
    "mmd",
    "ollama",
    "screen-aware",
    "speech-to-text",
    "text-to-speech",
    "three-js",
    "voice-assistant",
    "vrm",
    "vroid",
    "vtuber",
    "waifu",
    "whisper",
    "windows"
  ],
  "build": {
    "appId": "com.murtuza.deskmate",
    "productName": "Deskmate",
    "copyright": "Copyright © 2026 Muhammad Murtuza Hussain",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "asar": true,
    "files": [
      "out/**",
      "package.json",
      "!out/renderer/models/jian/**",
      "!out/renderer/models/nicole/**",
      "!out/renderer/models/ani/**",
      "!out/renderer/models/victoria/test.vrma"
    ],
    "extraResources": [
      {
        "from": "character/mika",
        "to": "character/mika"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "build",
        "to": "build",
        "filter": [
          "tray*.png",
          "tray.ico",
          "icon.png"
        ]
      },
      {
        "from": "tts-local",
        "to": "tts-local",
        "filter": [
          "**/*",
          "!.venv/**",
          "!__pycache__/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "extraResources": [
        {
          "from": "native/bin",
          "to": "bin",
          "filter": [
            "deskmate-hands"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureDescription": "Deskmate looks at your screen so your companion can react to what you are doing.",
        "NSMicrophoneUsageDescription": "Deskmate listens while hands-free mode is on, so you can talk to your companion.",
        "NSAppleEventsUsageDescription": "Deskmate controls the apps you ask her to use: Chrome to browse, Spotify to play music, Messages to send texts (always after your yes).",
        "NSCalendarsFullAccessUsageDescription": "Deskmate reads your upcoming events so your companion can remind you before they start. Nothing is changed.",
        "NSCalendarsUsageDescription": "Deskmate reads your upcoming events so your companion can remind you before they start. Nothing is changed."
      }
    },
    "dmg": {
      "artifactName": "Deskmate-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Deskmate",
      "artifactName": "Deskmate-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "Deskmate-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Deskmate",
          "Comment": "AI desk companion"
        }
      }
    },
    "publish": {
      "provider": "github",
      "owner": "MuhammadMurtuzaHussain",
      "repo": "deskmate",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "Deskmate-${version}-win-${arch}-portable.${ext}"
    }
  }
}
